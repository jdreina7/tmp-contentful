# Application Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/contentful_products_db

# Contentful API Configuration (REQUIRED)
# These variables are mandatory for the API to function correctly
CONTENTFUL_API_URL=https://www.contentful.com/developers/docs/references/content-delivery-api/
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_access_token_here
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_CONTENT_TYPE=product

# JWT Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# API Key for token generation
API_KEY=apply-digital-secret-key-2024
